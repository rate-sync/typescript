{
  "name": "rate-sync",
  "version": "0.1.0",
  "description": "Distributed rate limiting for TypeScript — token bucket, sliding window, Redis/Memory backends with Next.js integration",
  "type": "module",
  "license": "MIT",
  "author": "Rate-Sync Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/rate-sync/typescript.git"
  },
  "homepage": "https://github.com/rate-sync/typescript#readme",
  "bugs": { "url": "https://github.com/rate-sync/typescript/issues" },
  "keywords": [
    "rate-limiting",
    "distributed-systems",
    "rate-limiter",
    "nextjs",
    "redis",
    "typescript"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "import": "./dist/redis.js",
      "require": "./dist/redis.cjs"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js",
      "require": "./dist/postgres.cjs"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js",
      "require": "./dist/memory.cjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "require": "./dist/next.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "peerDependencies": {
    "next": ">=14.0.0",
    "pg": ">=8.0.0",
    "redis": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "redis": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "next": "^14.0.0",
    "react": "^18.0.0",
    "redis": "^4.7.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
